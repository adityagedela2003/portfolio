{
  "manifest_version": 3,
  "name": "InlineDoubt AI",
  "version": "1.0.0",
  "description": "Contextual inline AI doubts for chat interfaces and web pages.",
  "host_permissions": [
    "https://inlinedoubt-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
