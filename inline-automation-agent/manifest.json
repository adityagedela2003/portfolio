{
  "manifest_version": 3,
  "name": "InlineDoubt AI",
  "version": "1.0.0",
  "description": "Contextual inline AI doubts for chat interfaces and web pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
